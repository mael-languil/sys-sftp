#%RAML 1.0 DataType

type: object
properties:
  id:
    type: number
    required: true
  name:
    type: string
    required: true
  category:
    type: string
    enum: [Accessoire, Audio, Électronique, Graphisme, Sécurité]
    required: true
  price:
    type: number
    required: true
  stock:
    type: number
    required: true