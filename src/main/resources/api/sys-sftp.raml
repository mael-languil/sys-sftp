#%RAML 1.0
title: sys-sftp
description: Basic template to start new projects

#############
## Headers ##
#############

baseUri: https://{host}/api/v1
baseUriParameters:
  host:
    type: string
    displayName: Domain name
    example: app.cloudhub.com
protocols:
  - HTTPS

uses:
  paradisoLibrary: /exchange_modules/3b90109e-a38a-4252-ae3a-67ca3e9e3228/paradiso-library/1.0.0/paradiso-library.raml

# Secure all endpoints
#securedBy:
#  - paradisoLibrary.clientIdEnforcement

types:
  Invoice: !include datatype/Invoices.raml
  ProductInput: !include datatype/ProductsInput.raml
  ProductOutput: !include datatype/ProductsOutput.raml

###############
## Endpoints ##
###############

