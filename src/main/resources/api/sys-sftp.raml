/invoices:
  type:
    paradisoLibrary.CRUD-collection:
      resourceType: Invoice
  get:
    queryParameters:
      currency:
        type: string
        required: false
        enum: [USD, EUR]

  /{id}:
    uriParameters:
      id:
        type: string
        displayName: Unique identifier
        description: Invoice ID
    type:
      paradisoLibrary.CRUD-item:
        resourceType: Invoice
    get:


/products:
  type:
    paradisoLibrary.CRUD-collection:
      resourceType: ProductOutput
  get:
    queryParameters:
      category:
        type: string
        required: false
        enum: [Accessoire, Audio, Électronique, Graphisme, Sécurité, Stockage]
  post:
    is:
      - paradisoLibrary.error406

  /{id}:
    uriParameters:
      id:
        type: integer
        displayName: Unique identifier
        description: Product ID
        example: 1
    type:
      paradisoLibrary.CRUD-item:
        resourceType: ProductOutput
    post:
      description: Ajoute 1 au stock du produit
      is:
        - paradisoLibrary.error404
    delete:
      queryParameters:
        qty:
          type: integer
          required: false
          description: Quantité à retirer du stock (si absent, supprime le produit entier)
      is:
        - paradisoLibrary.error404


